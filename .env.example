# Скопируйте в .env и поправьте под свой компьютер.
# Docker Compose подхватывает .env автоматически.

APP_PORT=8095

# Папка с видео на хосте. На Windows можно писать G:/Video (прямые слэши).
VIDEO_ROOT=G:/Video

# Открытая регистрация: первый созданный аккаунт становится администратором.
ALLOW_REGISTRATION=true

SESSION_DAYS=30
TIMEZONE=Europe/Moscow

# Скачивание: до 1080p, два ролика параллельно, три попытки.
MAX_PARALLEL_DOWNLOADS=2
MAX_VIDEO_HEIGHT=1080
DOWNLOAD_RETRIES=3
POLL_CHECK_S=30

# cookies.txt в формате Netscape — положите в ./secrets/cookies.txt, если YouTube
# просит вход или проверку «я не робот». Файл не коммитится в git.
# YTDLP_COOKIES_FILE=/secrets/cookies.txt

# Необязательно: адрес bgutil-ytdlp-pot-provider, если он у вас запущен.
YTDLP_POT_BASE_URL=

LOG_LEVEL=INFO
